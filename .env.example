# Não coloque valores reais neste arquivo. Cadastre estas variáveis no painel da Vercel.
NODE_ENV=production
PORT=3000

# Banco atual do CMS (obrigatório enquanto o projeto estiver no MySQL)
DATABASE_URL=mysql://usuario:senha@host:3306/banco

# Autenticação Manus/OAuth usada pelo painel administrativo
MANUS_PROJECT_ID=seu_project_id
MANUS_JWT_SECRET=gere_um_segredo_forte
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_API_URL=https://api.manus.ai
MANUS_API_KEY=sua_chave_manus_se_necessaria
OWNER_OPEN_ID=seu_open_id_de_administrador

# Só use quando a integração Supabase for ativada no código/migração.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua_anon_key
# Nunca use SUPABASE_SERVICE_ROLE_KEY.
